generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model order_items {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  order_id   BigInt   @db.UnsignedBigInt
  product_id BigInt   @db.UnsignedBigInt
  quantity   Int      @default(1)
  price      Decimal  @db.Decimal(10, 2)
  orders     orders   @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_item_order")
  products   products @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_item_product")

  @@index([order_id], map: "fk_item_order")
  @@index([product_id], map: "fk_item_product")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model orders {
  id                 BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  order_no           String             @unique(map: "uk_order_no") @db.VarChar(64)
  user_id            BigInt             @db.UnsignedBigInt
  activity_id        BigInt             @db.UnsignedBigInt
  total_amount       Decimal            @db.Decimal(10, 2)
  status             Int                @default(0) @db.TinyInt
  created_at         DateTime?          @default(now()) @db.DateTime(0)
  updated_at         DateTime?          @default(now()) @db.DateTime(0)
  order_items        order_items[]
  seckill_activities seckill_activities @relation(fields: [activity_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_order_activity")

  @@index([activity_id], map: "idx_orders_activity")
  @@index([user_id, status], map: "idx_orders_user_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model products {
  id                 BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  name               String               @db.VarChar(255)
  description        String?              @db.Text
  price              Decimal              @db.Decimal(10, 2)
  total_stock        Int                  @default(0)
  created_at         DateTime?            @default(now()) @db.DateTime(0)
  updated_at         DateTime?            @default(now()) @db.DateTime(0)
  order_items        order_items[]
  seckill_activities seckill_activities[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model seckill_activities {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  product_id    BigInt    @db.UnsignedBigInt
  seckill_price Decimal   @db.Decimal(10, 2)
  stock         Int       @default(0)
  start_time    DateTime  @db.DateTime(0)
  end_time      DateTime  @db.DateTime(0)
  version       Int       @default(0)
  created_at    DateTime? @default(now()) @db.DateTime(0)
  orders        orders[]
  products      products  @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_activity_product")

  @@index([product_id], map: "fk_activity_product")
  @@index([start_time, end_time], map: "idx_seckill_time")
}
